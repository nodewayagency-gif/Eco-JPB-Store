# ==============================================================================
# Eco-JPB-Store - Variáveis de Ambiente Obrigatórias
# ==============================================================================

# Banco de Dados (PostgreSQL via Supabase / Prisma)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Supabase Storage & Autenticação
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Autenticação JWT (Chave Mestra para Assinatura de Tokens da Loja e Admin)
JWT_SECRET="gere_uma_chave_segura_de_no_minimo_32_caracteres_hex_ou_base64"

# URL Pública da Aplicação
NEXT_PUBLIC_APP_URL="https://www.jpbstorex.com.br"

# Mercado Pago - Modo (production ou test)
MP_MODE="test"

# Mercado Pago - Credenciais de Produção
NEXT_PUBLIC_MP_PUBLIC_KEY="APP_USR-..."
MP_ACCESS_TOKEN="APP_USR-..."
MP_WEBHOOK_SECRET="sua_chave_secreta_webhook_producao"

# Mercado Pago - Credenciais de Teste / Sandbox
NEXT_PUBLIC_MP_TEST_PUBLIC_KEY="TEST-..."
MP_TEST_ACCESS_TOKEN="TEST-..."
MP_TEST_WEBHOOK_SECRET="sua_chave_secreta_webhook_teste"

# Logística - Melhor Envio (test ou production)
MELHOR_ENVIO_MODE="test"
MELHOR_ENVIO_TOKEN="seu_token_melhor_envio_producao"
MELHOR_ENVIO_TEST_TOKEN="seu_token_melhor_envio_sandbox"

